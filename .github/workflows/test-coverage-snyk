name: CI - Build, Test & JaCoCo

on:
  push:
    branches: ["**"]
  pull_request:

permissions:
  contents: read
  checks: write
  pull-requests: write
  pages: write       # para publicar en Pages
  id-token: write    # requerido por deploy-pages

env:
  PROJECT_DIR: .   # ⬅️ cambia si tu pom.xml está en otra carpeta

jobs:
  snyk-scan:
    name: Snyk Security Scan (JSON)
    runs-on: ubuntu-latest
    env:
      SNYK_TOKEN: ${{ secrets.SNYK_TOKEN }}

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup JDK 21
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 21

      - name: Setup Snyk CLI
        uses: snyk/actions/setup@master

      - name: Snyk auth
        run: snyk auth "${SNYK_TOKEN}"

      # Ejecuta Snyk en la carpeta del proyecto y genera JSON (sin romper el pipeline)
      - name: Snyk test → JSON
        working-directory: ${{ env.PROJECT_DIR }}
        continue-on-error: true
        run: |
          chmod +x ./mvnw || true
          snyk test \
            --file=pom.xml \
            --package-manager=maven \
            --severity-threshold=high \
            --json-file-output=snyk-report.json

      # (Opcional) Resumen rápido en el Job Summary
      - name: Snyk summary
        if: always()
        working-directory: ${{ env.PROJECT_DIR }}
        run: |
          sudo apt-get update >/dev/null && sudo apt-get install -y jq >/dev/null
          TOTAL=$(jq '.vulnerabilities | length' snyk-report.json 2>/dev/null || echo 0)
          HIGH=$(jq '[.vulnerabilities[] | select(.severity=="high")] | length' snyk-report.json 2>/dev/null || echo 0)
          MED=$(jq '[.vulnerabilities[] | select(.severity=="medium")] | length' snyk-report.json 2>/dev/null || echo 0)
          LOW=$(jq '[.vulnerabilities[] | select(.severity=="low")] | length' snyk-report.json 2>/dev/null || echo 0)
          {
            echo "### Snyk Summary"
            echo ""
            echo "- Total: **$TOTAL**"
            echo "- High: **$HIGH**"
            echo "- Medium: **$MED**"
            echo "- Low: **$LOW**"
          } >> "$GITHUB_STEP_SUMMARY"

      # Sube el JSON como artefacto descargable
      - name: Upload Snyk JSON Report
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: snyk-report
          path: ${{ env.PROJECT_DIR }}/snyk-report.json
          if-no-files-found: warn

  # 2) Pruebas unitarias y cobertura JaCoCo (ejecutando en app/)
  build-test-coverage: # Nombre del job
    runs-on: ubuntu-latest # Corre en una máquina virtual Ubuntu que GitHub te da.
    timeout-minutes: 30 # si tarda más, se cancela automáticamente

    steps:
      - name: Checkout # Clona tu repositorio dentro de la VM. Obligatorio para poder compilar/testear tu código.
        uses: actions/checkout@v4 

      - name: Setup JDK 21 # Instala Java 21 en el runner (en este caso ubuntu-latest).
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 21
          cache: maven

      # Ejecuta tus tests con cobertura. Si en el POM tienes el jacoco:check con mínimos,
      # este paso FALLA el job si no se cumple el umbral.
      - name: Build & Test (with coverage)
        run: mvn -B -U clean verify

      # Sube el reporte de cobertura como artefacto descargable desde la ejecución
      - name: Upload JaCoCo report
        if: always()   # lo sube aunque el verify falle, para poder revisar
        uses: actions/upload-artifact@v4
        with:
          name: jacoco-report
          path: |
            **/target/site/jacoco/**
            **/target/site/jacoco-aggregate/**
          if-no-files-found: ignore

      # (Opcional) Publica resultados JUnit en la pestaña de Checks
      - name: Publish JUnit test results
        if: always()
        uses: mikepenz/action-junit-report@v4
        with:
          report_paths: '**/target/surefire-reports/*.xml'
          check_name: 'JUnit Results'
          detailed_summary: true
